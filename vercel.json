{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    },
    "api/convert.js": {
      "maxDuration": 30
    },
    "api/convert-multiple.js": {
      "maxDuration": 30
    },
    "api/test.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/convert",
      "destination": "/api/convert.js"
    },
    {
      "source": "/api/convert-multiple",
      "destination": "/api/convert-multiple.js"
    },
    {
      "source": "/api/test",
      "destination": "/api/test.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/dist/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/dist/$1"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
