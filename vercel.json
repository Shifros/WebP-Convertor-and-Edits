{
	"version": 2,
	"functions": {
		"api/convert.js": { "maxDuration": 30 },
		"api/convert-multiple.js": { "maxDuration": 30 },
		"api/test.js": { "maxDuration": 10 },
		"api/health.js": { "maxDuration": 5 }
	},
	"rewrites": [
		{ "source": "/api/convert", "destination": "/api/convert.js" },
		{ "source": "/api/convert-multiple", "destination": "/api/convert-multiple.js" },
		{ "source": "/api/test", "destination": "/api/test.js" },
		{ "source": "/api/health", "destination": "/api/health.js" },
		{ "source": "/", "destination": "/dist/index.html" },
		{ "source": "/(.*)", "destination": "/dist/$1" }
	],
	"buildCommand": "npm run build",
	"outputDirectory": "dist"
}
